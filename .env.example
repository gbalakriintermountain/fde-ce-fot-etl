# Copy this file to ".env" and fill in real credentials.
# Never commit the real ".env" file to source control.

# --- Oracle source database ---
ORACLE_USER=oracle_username
ORACLE_PASSWORD=oracle_password
# DSN format: host:port/service_name  (e.g. myhost.company.com:1521/ORCLPDB1)
ORACLE_DSN=host:1521/service_name

# --- SQL Server target database ---
SQLSERVER_HOST=sqlserver_host_or_ip
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=target_database
SQLSERVER_USER=sqlserver_username
SQLSERVER_PASSWORD=sqlserver_password
